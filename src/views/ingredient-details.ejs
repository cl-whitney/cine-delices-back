<%- include('partials/head') %>

<h1>Détail de l’ingrédient</h1>

<% if (ingredient) { %>
  <ul>
    <li><strong>Nom :</strong> <%= ingredient.name %></li>
    <li><strong>Unité :</strong> <%= ingredient.unity %></li>
    <li><strong>Statut :</strong> <%= ingredient.status ? 'Actif' : 'Inactif' %></li>
    <li><strong>Créé le :</strong> <%= ingredient.created_at.toLocaleDateString() %></li>
    <% if (ingredient.updated_at) { %>
      <li><strong>Mis à jour le :</strong> <%= ingredient.updated_at.toLocaleDateString() %></li>
    <% } %>
  </ul>
<% } else { %>
  <p>Aucun ingrédient à afficher.</p>
<% } %>

<p><a href="/admin/ingredients">← Retour à la liste des ingrédients</a></p>

<%- include('partials/foot') %>
