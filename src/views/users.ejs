<%- include('partials/head') %>

<main class="main-data-container">
  <% let totalUsers = locals.users?.length || 0; %>
  <h1 class="title-page">Utilisateurs : <%= totalUsers %></h1>
  
  <% if (locals.users?.length) { %>
    <ul>
      <% locals.users.forEach((user, index) => { %>
        <li class="data-list <%= index % 2 === 0 ? 'even' : 'odd' %>">
          <h3>Utilisateur <%= index + 1 %> :</h3>
          <p>
            Nom : <%= user.last_name %>
          </p>
          <p>Prénom : <%= user.first_name %></p>
          <p style="color: <%= user.role === 'admin' ? 'red' : 'inherit' %>;">
            Rôle : <%= user.role %></p>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>

<%- include('partials/foot') %>