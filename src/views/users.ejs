<%- include('partials/head') %>

<h1 class="title-page">Utilisateurs</h1>

<% if (locals.users?.length) { %>
  <ul>
    <% locals.users.forEach((user, index) => { %>
      <li class="data-list">
        <h3>Utilisateur <%= index + 1 %> :</h3>
        <p>
          Nom : <%= user.last_name %>
        </p>
        <p>Prénom : <%= user.first_name %></p>
        <p style="color: <%= user.role === 'admin' ? 'red' : 'inherit' %>;">
          Rôle : <%= user.role %></p>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/foot') %>