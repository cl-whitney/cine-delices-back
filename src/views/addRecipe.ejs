<%- include ('partials/head') %>

<main class="main-connexion">

    <h1>Ajouter une recette :</h1>

    <form class="form-container" action="/admin/recettes" method="POST">
        <input type="hidden" name="user_id" value="<%= userId %>">
        <div class="form-input-container">
            <label class="form-label" for="title">Titre :</label>
            <input class="form-input" type="text" id="title" name="title" placeholder="Lasagnes" value= "<%= formData.title%>" required >
        </div>

        <div class="form-input-container">
            <label class="form-label" for="image">Image</label>
            <input class="form-input" type="file" id="image" name="image" accept="image/*"
             value="<%= formData.image %>">
        </div>

        <div class="form-input-container">
            <label class="form-label" for="description">Description </label>
            <input class="form-input" type="textarea" id="description" name="description" value=" <%= formData.description %>">
        </div>

        <div class="form-input-container">
            <label class="form-label" for="instruction">Instruction </label>
            <input class="form-input" type="textarea" id="instruction" name="instruction" value=" <%= formData.instruction %>">
        </div>

        <div class="form-input-container">
            <label class="form-label" for="duration">Durée </label>
            <input class="form-input" type="text" id="duration" name="duration" value=" <%= formData.duration %>" required>
        </div>

        <div class="form-input-container">
            <label class="form-label" for="difficulty">Difficulté </label>
            <select id="difficulty" name="difficulty">
                <option value="Facile"  <%= formData.difficulty==='Facile'  ? 'selected' : '' %>>Facile</option>
                <option value="Moyen"   <%= formData.difficulty==='Moyen'   ? 'selected' : '' %>>Moyen</option>
                <option value="Difficile"<%= formData.difficulty==='Difficile'? 'selected' : '' %>>Difficile</option>
            </select>
        </div>

        <div class="form-input-container">
            <select id="cost" name="cost">
                <option value="Petit budget"        <%= formData.cost==='Petit budget'        ? 'selected' : '' %>>Petit budget</option>
                <option value="Rapport qualité prix"<%= formData.cost==='Rapport qualité prix'? 'selected' : '' %>>Rapport qualité prix</option>
                <option value="Couteux"             <%= formData.cost==='Couteux'             ? 'selected' : '' %>>Couteux</option>
            </select>

        <input class="log-btn login-btn" type="submit"value="Valider">

        <% if (errors && errors.length > 0) { %>
            <ul>
                <% errors.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }); %>
            </ul>
        <% } %>
    </form>
</main>

<%- include ('partials/foot') %>