<%- include ('partials/head') %>

<main class="main-connexion">

    <h1>Ajouter une Category :</h1>

    <form class="form-container" action="/admin/categories" method="POST">
        <!-- <input type="hidden" name="user_id" value="<%= // userId %>"> -->
        <div class="form-input-container">
            <label class="form-label" for="title">Titre :</label>
            <input class="form-input" type="text" id="name" name="name" placeholder="plat" value= "<%= formData.name%>" required >
        </div>

        <input class="log-btn login-btn" type="submit"value="Valider">

        <% if (errors && errors.length > 0) { %>
            <ul>
                <% errors.forEach(function(error) { %>
                    <li><%= error %></li>
                <% }); %>
            </ul>
        <% } %>
    </form>
</main>

<%- include ('partials/foot') %>