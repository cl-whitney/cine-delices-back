<%- include ('partials/head') %>

<h1 class="title-page">Liste des médias</h1>

<% if (locals.medias.length) { %>
    <% medias.forEach(media => {%>
        <ul>
            <li class="data-list">
                <a href="/admin/medias/<%= media.id %>">
                <p>Titre : <%=media.title %></P>
                </a>
                <p> type : <%= media.type %></p>
            </li>
        </ul>
    <%})%>
<% } %>


<%- include ('partials/foot') %>