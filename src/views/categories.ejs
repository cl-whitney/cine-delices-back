<%- include('partials/head') %>

<h1 class="title-page">Catégories</h1>

<% if (category && category.length) { %>
  <ul>
    <% category.forEach(cat => { %>
      <li>
          <p>Nom : <%= cat.name %></p>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p>Aucune catégorie trouvée.</p>
<% } %>

<%- include('partials/foot') %>
