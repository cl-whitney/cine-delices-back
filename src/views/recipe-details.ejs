<%- include ('partials/head') %>

<h1>Recettes</h1>

<% recipes.forEach(recipe => {%>
    <li>
        <h2>Titre : <%recipe.title %></h2>
        <p> <img src=" <% recipe.image %>" alt="<% recipe.title %>"></p>
        <p>Description : <%recipe.description %></p>
        <p>Instruction : <% recipe.instruction %></p>
        <p>Temps : <% recipe.duration %></p>
        <p>Difficultée : <% recipe.difficulty %></p>
        <p>Cout: <% recipe.cost %></p>
        <p>Status : <% recipe.status %></p>
    </li>
<%})%>



<%- include ('partials/foot') %>