<%- include ('partials/head') %>

<main class="main-data-container">
    <form class="form-add-btn" action="/admin/recette/formulaire" method="GET">
        <button class="log-btn" type="submit">Ajouter une recette</button>
    </form>

    <% let totalRecipes = locals.recipes?.length || 0; %> 
    
    <h1 class="title-page">Recettes : <%= totalRecipes %></h1>
    
    <% if (locals.recipes?.length) { %>
        <ul>
            <% locals.recipes.forEach((recipe, index) => { %>
                <li class="data-list <%= index % 2 === 0 ? 'even' : 'odd' %>">
                    <h3>Rec n°<%= index + 1 %> :
                        <a href="/admin/recettes/<%= recipe.id %>">
                            <%= recipe.title %>
                        </a>
                    </h3>
                    <p><img src="<%= recipe.image%>" alt="<%= recipe.title %>"></p>
                    <div class="form-btn-handlers">
                        <form class="d-inline" action="/admin/recettes/<%= recipe.id %>/delete" method="POST">
                            <input class="btn btn-outline-danger py-0 px-1 ms-3 fs-6" type="submit" value="SUPPRIMER"
>
                        </form>
                        <form
                            class="d-inline"
                            action="/admin/recettes/<%= recipe.id %>/edit"
                            method="POST"
                        >
                            <input
                                class="btn btn-outline-primary py-0 px-1 ms-3 fs-6"
                                type="submit"
                                value="MODIFIER"
                            >
                        </form>

                    </div>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>Aucune recette disponible.</p>
    <% } %>

</main>

<%- include ('partials/foot') %>